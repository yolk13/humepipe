<%- include('partials/header') %>

<div class="container mx-auto px-4 py-[68px] max-w-4xl">
    <a href="/blogs" class="text-primary font-bold hover:underline mb-[26px] inline-block">&larr; Back to Blogs</a>
    <h1 class="text-[42px] md:text-[68px] font-bold text-ink mb-4 leading-[1.1]"><%= blog.title %></h1>
    <p class="text-slate mb-[42px]"><%= new Date(blog.published_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %></p>
    <article class="max-w-none text-[17px] text-slate leading-8
        [&_h2]:text-[26px] [&_h2]:font-bold [&_h2]:text-ink [&_h2]:mt-[42px] [&_h2]:mb-[16px]
        [&_h3]:text-[26px] [&_h3]:font-bold [&_h3]:text-ink [&_h3]:mt-[42px] [&_h3]:mb-[16px]
        [&_h4]:font-bold [&_h4]:text-ink [&_h4]:mt-[26px] [&_h4]:mb-[10px]
        [&_p]:mb-[26px]
        [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:mb-[26px] [&_ul_space-y-2]:space-y-2
        [&_ol]:list-decimal [&_ol]:pl-6 [&_ol]:mb-[26px]
        [&_a]:text-primary [&_a]:underline
        [&_img]:max-w-full [&_img]:h-auto [&_img]:my-[26px]
        [&_blockquote]:border-l-4 [&_blockquote]:border-accent [&_blockquote]:pl-4 [&_blockquote]:italic
        [&_pre]:bg-ink [&_pre]:text-white [&_pre]:p-4 [&_pre]:overflow-x-auto [&_pre]:mb-[26px]
        [&_code]:bg-line [&_code]:px-1 [&_code]:py-0.5">
        <%- sanitizeHtml(blog.content) %>
    </article>
</div>

<%- include('partials/footer') %>