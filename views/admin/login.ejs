<%- include('../partials/admin-header') %>

<div class="max-w-sm mx-auto bg-white p-8 border border-line mt-16">
    <h1 class="text-[26px] font-bold text-ink mb-6 text-center">Admin Login</h1>
    <% if (flash) { %>
        <div class="p-3 mb-6 rounded text-sm font-bold <%= flash.type === 'success' ? 'bg-green-50 text-green-700 border border-green-200' : 'bg-red-50 text-red-700 border border-red-200' %>">
            <%= flash.text %>
        </div>
    <% } %>
    <form method="post" action="/admin/login" class="space-y-6">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div>
            <label for="email" class="block text-sm font-bold mb-2">Email</label>
            <input type="email" id="email" name="email" required
                class="w-full border-b-2 border-line focus:border-primary focus-visible:border-primary outline-none py-2 bg-transparent">
        </div>
        <div>
            <label for="password" class="block text-sm font-bold mb-2">Password</label>
            <input type="password" id="password" name="password" required
                class="w-full border-b-2 border-line focus:border-primary focus-visible:border-primary outline-none py-2 bg-transparent">
        </div>
        <button type="submit" class="w-full bg-primary hover:bg-primaryDark text-white py-3 font-bold">Login</button>
    </form>
</div>

<%- include('../partials/admin-footer') %>