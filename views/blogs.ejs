<%- include('partials/header') %>

<div class="container mx-auto px-4 py-[68px] md:py-[110px]">
    <p class="text-xs font-bold tracking-[0.05em] uppercase text-primary mb-[10px] text-center">Insights</p>
    <h1 class="text-[42px] md:text-[68px] font-bold text-ink mb-[42px] text-center">Latest News &amp; Blogs</h1>

    <% if (blogs.length === 0) { %>
        <div class="text-center text-slate py-[68px]">
            <p class="text-xl">No blogs published yet. Check back soon!</p>
        </div>
    <% } else { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[26px]">
            <% blogs.forEach(blog => { %>
                <div class="bg-white border border-line">
                    <% if (blog.featured_image) { %>
                        <img src="<%= blog.featured_image %>" alt="<%= blog.title %>" class="w-full h-48 object-cover" loading="lazy">
                    <% } else { %>
                        <div class="w-full h-48 bg-neutral border-b border-line flex items-center justify-center">
                            <span class="text-2xl font-bold text-primary">C</span>
                        </div>
                    <% } %>
                    <div class="p-[26px]">
                        <p class="text-xs text-slate mb-2"><%= new Date(blog.published_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %></p>
                        <h2 class="text-xl font-bold text-ink mb-4"><%= blog.title %></h2>
                        <a href="/blogs/<%= blog.slug %>" class="text-primary font-bold hover:underline">Read More &rarr;</a>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>
</div>

<%- include('partials/footer') %>