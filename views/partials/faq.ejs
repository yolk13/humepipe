<section class="py-[68px] md:py-[110px] bg-neutral">
    <div class="container mx-auto px-4 max-w-4xl">
        <p class="text-xs font-bold tracking-[0.05em] uppercase text-primary mb-[10px] text-center">Q&amp;A</p>
        <h2 class="text-[42px] font-bold text-ink mb-[10px] text-center"><%= typeof faqTitle !== 'undefined' && faqTitle ? faqTitle : 'Frequently Asked Questions' %></h2>
        <p class="text-lg text-slate text-center mb-[42px]">Quick answers to common questions about our RCC concrete pipes.</p>
        <div class="space-y-4">
            <% faqs.forEach(f => { %>
                <details class="bg-white border border-line group">
                    <summary class="list-none flex justify-between items-center px-6 py-5 cursor-pointer font-bold text-ink text-lg">
                        <%= f.q %>
                        <span class="text-accent text-2xl group-open:hidden">+</span>
                        <span class="text-accent text-2xl hidden group-open:inline">&minus;</span>
                    </summary>
                    <div class="px-6 pb-6 text-slate leading-7"><%= f.a %></div>
                </details>
            <% }) %>
        </div>
    </div>
</section>