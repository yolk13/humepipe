# Copy to .env and fill in real values. Port 3000 is environment-owned; use 3001+.
PORT=3001
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Postgres connection string. Required on Vercel and in production.
# On Neon use the pooled connection string: postgres://...?...sslmode=require
# DATABASE_URL=

# Vercel Blob token. When unset, uploads fall back to public/uploads on disk
# (local dev / tests only — does not persist on Vercel).
# BLOB_READ_WRITE_TOKEN=

# Notifications (optional). Without SMTP_HOST, emails log to console only.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=user@example.com
# SMTP_PASS=your-password
# SMTP_FROM=Contech Concrete <info@contech.com.np>
# ADMIN_EMAIL=admin@contech.com.np

# Public site URL, used for the admin-alert link inside notification emails.
# SITE_URL=https://contech.example.com