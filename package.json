{
  "name": "contech-humepipe",
  "version": "0.1.0",
  "private": true,
  "description": "Contech Concrete and Allied Industries — B2B hume pipe portal (Next.js + Payload CMS).",
  "workspaces": [
    "web",
    "cms",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:web dev:cms",
    "dev:web": "npm --workspace web run dev",
    "dev:cms": "npm --workspace cms run dev",
    "build": "npm run build --workspace web && npm run build --workspace cms",
    "lint": "npm run lint --workspace web",
    "typecheck": "npm run typecheck --workspace @contech/shared"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
